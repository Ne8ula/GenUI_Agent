# Non-secret values for the Claude Cloud environment's variable editor.
# Copy values into Cloud; do not source this file as a shell program.
# These values do not select a model, authorize spending, or prove a Weave gate.
CI=true
TZ=UTC

# Task coordination hints consumed by the handoff instructions, not app controls.
# Only foundations is supported by this default overnight handoff.
EVA_W4_WORK_MODE=foundations
EVA_W4_PROVIDER_MODE=mock
# Leave unset/empty tonight: no current Week 4 Weave packet exists.
# A future path alone is NOT permission to implement UI; inspect scope/provenance.
EVA_W4_REFERENCE_PACKET=

# Operational controls for week4/scripts/cloud-setup.sh after checkout.
# Install only an existing week4 package+lock; absent manifests are deferred.
EVA_CLOUD_INSTALL_NODE_DEPS=1
# npm lifecycle scripts stay disabled unless reviewed and separately enabled.
EVA_CLOUD_NPM_LIFECYCLE_SCRIPTS=0
# No Cargo downloads during setup by default. Rust mock/unit work is still allowed.
EVA_CLOUD_FETCH_RUST_DEPS=0

# No provider credentials are needed for the default fixture-only work.
# DO NOT add/copy ANTHROPIC_BASE_URL, local model alias pins, Gateway credentials,
# CLAUDE_CODE_SUBAGENT_MODEL, Figma/Weave OAuth tokens, Windows .env files,
# OPENAI_API_KEY, ELEVENLABS_API_KEY, or real microphone/camera data here.
# Do not unset or replace Cloud's own host-managed authentication either.
# Future real-provider tests need separately authorized, scoped secret handling.
