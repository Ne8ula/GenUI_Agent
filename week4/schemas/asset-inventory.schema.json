{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eva.local/week4/schemas/asset-inventory.schema.json",
  "title": "EVA Week 4 asset and reference inventory",
  "description": "Required runtime assets and owner references with source/rights status. Missing files are explicit; nothing here grants licence clearance.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "references", "assets"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "references": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "file", "sha256", "role", "runtimeUse", "notes"],
        "properties": {
          "id": { "type": "string", "pattern": "^ref:owner-[0-9a-f]{8}$" },
          "file": { "type": "string", "pattern": "^references/[0-9a-f]{32}\\.jpg$" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "role": { "const": "owner-mood-reference" },
          "runtimeUse": { "const": "prohibited" },
          "notes": { "type": "string", "maxLength": 300 }
        }
      }
    },
    "assets": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "sceneIds", "variants", "layers", "source", "rights", "status", "file", "sha256", "blockedBy"],
        "properties": {
          "id": { "type": "string", "maxLength": 80, "pattern": "^(?:tex|mesh|card|wallpaper|sfx|amb|voice|font|anim):[a-z0-9]+(?:[.:-][a-z0-9]+)*$" },
          "kind": { "enum": ["texture", "mesh", "card", "wallpaper-render", "sound-effect", "ambience", "voice-take", "font", "animation-curve"] },
          "sceneIds": {
            "type": "array",
            "maxItems": 32,
            "items": { "type": "string", "pattern": "^(?:scene|anchor|obj|layer|actors|fx):[a-z0-9]+(?:-[a-z0-9]+)*$" }
          },
          "variants": {
            "type": "array",
            "maxItems": 4,
            "uniqueItems": true,
            "items": { "enum": ["afternoon-clear", "afternoon-rain", "evening-clear", "evening-rain"] }
          },
          "layers": { "type": "array", "maxItems": 8, "uniqueItems": true, "items": { "enum": ["colour", "alpha", "depth", "normal", "line", "wash", "emissive"] } },
          "source": { "enum": ["weave-reference-then-native-reconstruction", "native-authoring", "licensed-library", "eleven-v3-take", "open-font"] },
          "rights": { "enum": ["unreviewed", "licence-required", "terms-review-required", "ofl-pending-bundle"] },
          "status": { "const": "missing" },
          "file": { "type": "null" },
          "sha256": { "type": "null" },
          "blockedBy": { "type": "array", "minItems": 1, "maxItems": 6, "items": { "type": "string", "maxLength": 80 } }
        }
      }
    }
  }
}
