{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eva.local/week4/schemas/weave-jobs.schema.json",
  "title": "EVA Week 4 finite Weave job checklist",
  "description": "Planned Weave reference jobs from DESIGN_PROMPT.md §10–§13. Every job is not run and awaiting cost approval; run IDs, model IDs and costs stay null until a real, approved run exists.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "route", "jobs"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "modelOrWorkflowId", "discoveredOn"],
      "properties": {
        "kind": { "enum": ["undecided", "direct-model", "workflow"] },
        "modelOrWorkflowId": { "type": "null" },
        "discoveredOn": { "type": "null" }
      }
    },
    "jobs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "packet", "media", "promptSource", "brief", "status", "runId", "quotedCost", "approvedBy", "outputs"],
        "properties": {
          "id": { "type": "string", "pattern": "^(?:S1|S2[a-c]|C[1-6]|F[1-4]|D1|A[1-3]|V[1-8])$" },
          "packet": { "enum": ["P1-arrival", "P2-desktop", "P3-follow-ups"] },
          "media": { "enum": ["image", "video"] },
          "promptSource": { "type": "string", "maxLength": 80 },
          "brief": { "type": "string", "maxLength": 300 },
          "status": { "const": "not-run-awaiting-cost-approval" },
          "runId": { "type": "null" },
          "quotedCost": { "type": "null" },
          "approvedBy": { "type": "null" },
          "outputs": { "type": "array", "maxItems": 0 }
        }
      }
    }
  }
}
