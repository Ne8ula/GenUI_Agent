{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eva.local/week4/schemas/narration-manifest.schema.json",
  "title": "EVA Week 4 narration manifest",
  "description": "Authored narrator lines by stable line ID. The renderer may request only a line ID; it never supplies text, voice, model or credentials. Audio is either missing or a reviewed, listened take.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "policy", "lines"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modelId", "stability", "maxStackedTags", "maxCharacters", "targetMinCharacters", "allowedTags", "quietTags", "loudTags", "source"],
      "properties": {
        "modelId": { "const": "eleven_v3" },
        "stability": { "const": 0.5 },
        "maxStackedTags": { "type": "integer", "minimum": 1, "maximum": 3 },
        "maxCharacters": { "type": "integer", "minimum": 1, "maximum": 1200 },
        "targetMinCharacters": { "type": "integer", "minimum": 1, "maximum": 1200 },
        "allowedTags": { "$ref": "#/$defs/tagList" },
        "quietTags": { "$ref": "#/$defs/tagList" },
        "loudTags": { "$ref": "#/$defs/tagList" },
        "source": { "type": "string", "maxLength": 200 }
      }
    },
    "lines": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["lineId", "text", "origin", "shortFormException", "audio"],
        "properties": {
          "lineId": { "type": "string", "maxLength": 48, "pattern": "^[a-z]+(?:-[a-z]+)*\\.[a-z]+(?:-[a-z]+)*$" },
          "text": { "type": "string", "minLength": 1, "maxLength": 1200 },
          "origin": { "enum": ["planning.md §3", "planning.md §6.5", "cloud-proposal-unreviewed"] },
          "shortFormException": { "type": ["string", "null"], "maxLength": 200 },
          "audio": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["status"],
                "properties": { "status": { "const": "missing" } }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["status", "assetId", "sha256", "listenedBy", "listenedOn"],
                "properties": {
                  "status": { "const": "reviewed" },
                  "assetId": { "type": "string", "pattern": "^voice:[a-z0-9.-]{1,60}$" },
                  "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                  "listenedBy": { "const": "owner" },
                  "listenedOn": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
                }
              }
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "tagList": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z :.0-9]{0,23}$" }
    }
  }
}
