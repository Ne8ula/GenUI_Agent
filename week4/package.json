{
  "name": "eva-week4-foundations",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "EVA Week 4: scene contracts, intents, timeline, projection math (core) and the Vite/React renderer host (app).",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "npm run typecheck && npm test && npm run check --workspace app",
    "rust:test": "cargo test --manifest-path Cargo.toml",
    "check:core": "npm run typecheck && npm test",
    "app:dev": "npm run dev --workspace app",
    "app:capture": "npm run capture --workspace app"
  },
  "dependencies": {
    "ajv": "^8.20.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "~5.9.2"
  },
  "workspaces": [
    "app"
  ]
}
