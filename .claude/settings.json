{
  "model": "claude-gpt-6-astra[1m]",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/agents/weave-reference-reminder.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/agents/weave-reference-reminder.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|Bash|PowerShell|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/agents/weave-reference-reminder.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "model-gateway@eigenwise-toolshed": true,
    "ruflo-core@ruflo": true,
    "ponytail@ponytail": true
  },
  "extraKnownMarketplaces": {
    "eigenwise-toolshed": {
      "source": {
        "source": "github",
        "repo": "Eigenwise/eigenwise-toolshed"
      }
    }
  },
  "effortLevel": "high"
}
