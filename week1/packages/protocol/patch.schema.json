{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "kind": {
      "const": "set-wind"
    },
    "cardId": {
      "const": "weather-primary"
    },
    "baseRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 999999
    },
    "showWind": {
      "type": "boolean"
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "cardId",
    "baseRevision",
    "showWind"
  ]
}
