{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "const": "weather-ithaca-week"
    },
    "source": {
      "const": "synthetic"
    },
    "location": {
      "const": "Ithaca, New York"
    },
    "timezone": {
      "const": "America/New_York"
    },
    "days": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^2026-09-[0-9]{2}$"
          },
          "condition": {
            "enum": [
              "clear",
              "partly-cloudy",
              "cloudy",
              "rain"
            ]
          },
          "highC": {
            "anyOf": [
              {
                "type": "number",
                "minimum": -60,
                "maximum": 60
              },
              {
                "type": "null"
              }
            ]
          },
          "lowC": {
            "anyOf": [
              {
                "type": "number",
                "minimum": -60,
                "maximum": 60
              },
              {
                "type": "null"
              }
            ]
          },
          "precipitationPct": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              {
                "type": "null"
              }
            ]
          },
          "windKph": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 250
              },
              {
                "type": "null"
              }
            ]
          },
          "windDirection": {
            "enum": [
              "N",
              "NE",
              "E",
              "SE",
              "S",
              "SW",
              "W",
              "NW",
              null
            ]
          }
        },
        "required": [
          "date",
          "condition",
          "highC",
          "lowC",
          "precipitationPct",
          "windKph",
          "windDirection"
        ]
      }
    }
  },
  "required": [
    "id",
    "source",
    "location",
    "timezone",
    "days"
  ]
}
