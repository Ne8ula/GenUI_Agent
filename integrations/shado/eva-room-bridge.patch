+import { configuredClerk } from '@/server/clerk-config';
+import { evaAllowedOrigin } from '@/lib/eva-room-handoff.mjs';
+import AuthorizeRoom from './authorize-room';
+
+export const dynamic = 'force-dynamic';
+export default function EvaRoomAuthorizationPage() {
+  let allowedOrigin: string;
+  try {
+    if (!configuredClerk() || !process.env.SHADO_EVA_BRIDGE_SECRET) throw new Error();
+    allowedOrigin = evaAllowedOrigin(process.env.SHADO_EVA_ALLOWED_ORIGIN);
+  } catch {
+    return <main style={{ padding: '3rem', maxWidth: '40rem', margin: 'auto' }}><h1>EVA authorization is not configured</h1>
+      <p>The Shado operator must configure the dedicated bridge key and exact EVA origin before this connection can be used.</p></main>;
+  }
+  return <AuthorizeRoom allowedOrigin={allowedOrigin}/>;
+}
