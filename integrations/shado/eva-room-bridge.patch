+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { evaAllowedOrigin, parseEvaRoomPacket } from './eva-room-handoff.mjs';
+const packet = () => ({ type: 'eva-room-request', nonce: 'a'.repeat(64), jobId: '12345678-1234-4234-8234-123456789abc',
+  taskId: 'abcdef12-1234-4234-8234-123456789abc',
+  assets: Array.from({ length: 5 }, (_, index) => ({ id: `photo-${index}`, sha256: 'b'.repeat(64), size: 100, mimeType: 'image/png' })) });
+test('handoff only accepts an exact configured origin', () => {
+  assert.equal(evaAllowedOrigin('http://127.0.0.1:5173'), 'http://127.0.0.1:5173');
+  assert.equal(evaAllowedOrigin('https://eva.example'), 'https://eva.example');
+  for (const origin of [undefined, '*', 'http://eva.example', 'https://eva.example/path', 'https://user@eva.example', 'https://eva.example?q=1'])
+    assert.throws(() => evaAllowedOrigin(origin));
+});
+test('handoff packet is bounded, closed and copied before approval', () => {
+  const original = packet(), parsed = parseEvaRoomPacket(original);
+  original.assets[0].sha256 = '0'.repeat(64);
+  assert.equal(parsed.assets[0].sha256, 'b'.repeat(64));
+  for (const mutate of [p => p.ownerId = 'victim', p => p.nonce = 'short', p => p.taskId = 'unbound',
+    p => p.assets.pop(), p => p.assets[0].url = 'https://evil.example', p => p.assets[0].mimeType = 'text/html',
+    p => p.assets[0].size = 99_000_000, p => p.assets[1].id = p.assets[0].id]) {
+    const bad = packet(); mutate(bad); assert.throws(() => parseEvaRoomPacket(bad));
+  }
+});
