index 0000000..049cc98
--- /dev/null
+++ b/src/app/eva-room-authorize/authorize-room.tsx
@@ -0,0 +1,115 @@
+'use client';
+
+import { useEffect, useRef, useState, type FormEvent } from 'react';
+import { SignIn, useAuth, useUser } from '@clerk/nextjs';
+import { AuthShell } from '@/components/clerk-auth';
+import { Button } from '@/components/ui/button';
+import { parseEvaRoomPacket } from '@/lib/eva-room-handoff.mjs';
+import styles from './authorize-room.module.css';
+
+type Packet = { type: string; nonce: string; jobId: string; taskId: string;
+  assets: Array<{ id: string; sha256: string; size: number; mimeType: string }> };
+type Proposal = { project: string; nodeId: string; taskId: string; jobId: string; recipeHash: string; prompt: string;
+  modelId: string; settings: Record<string, string>;
+  assets: Array<{ sourceId: string; version: string; sha256: string; size: number; mimeType: string }> };
+type Offer = { maximumCostUsd: number; pricing: { amountMicros: number }; expiresAt: string };
+
+async function bridge(body: unknown, signal: AbortSignal) {
+  const response = await fetch('/api/eva-room-bridge', { method: 'POST', redirect: 'error', credentials: 'same-origin',
+    headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body),
+    signal: AbortSignal.any([signal, AbortSignal.timeout(30_000)]) });
+  const text = await response.text();
+  if (text.length > 3_200_000) throw new Error('The authorization response is too large.');
+  let result;
+  try { result = JSON.parse(text); } catch { throw new Error('Shado could not confirm the authorization request.'); }
+  if (!response.ok || result.ok !== true) throw new Error(typeof result.error?.message === 'string'
+    ? result.error.message : 'Shado could not verify this room request.');
+  return result;
+}
+
+export default function AuthorizeRoom({ allowedOrigin }: { allowedOrigin: string }) {
+  const { isLoaded, userId, orgId, sessionId } = useAuth(), { user } = useUser();
+  const received = useRef<Packet | null>(null), inFlight = useRef<AbortController | null>(null);
+  const [packet, setPacket] = useState<Packet | null>(null), [proposal, setProposal] = useState<Proposal | null>(null);
+  const [offer, setOffer] = useState<Offer | null>(null), [cap, setCap] = useState(''), [approved, setApproved] = useState(false);
+  const [busy, setBusy] = useState(false), [delivered, setDelivered] = useState(false), [error, setError] = useState('');
+  const [reload, setReload] = useState(0);
+  useEffect(() => {
+    if (!window.opener) { setError('Open this authorization window from your EVA room.'); return; }
+    const receive = (event: MessageEvent) => {
+      if (event.origin !== allowedOrigin || event.source !== window.opener || received.current) return;
+      try {
+        const value = parseEvaRoomPacket(event.data) as Packet;
+        received.current = value; setPacket(value); setError('');
+      } catch { setError('The EVA room request could not be verified. Close this window and reconnect from EVA.'); }
+    };
+    window.addEventListener('message', receive);
+    window.opener.postMessage({ type: 'eva-room-ready' }, allowedOrigin);
+    return () => { window.removeEventListener('message', receive); inFlight.current?.abort(); };
+  }, [allowedOrigin]);
+  useEffect(() => {
+    inFlight.current?.abort();
+    setProposal(null); setOffer(null); setApproved(false); setDelivered(false);
+    if (!userId || !packet) return;
+    const controller = new AbortController(); inFlight.current = controller;
+    setBusy(true); setError('');
+    void bridge({ operation: 'proposal', packet }, controller.signal).then(result => {
+      if (controller.signal.aborted) return;
+      const value = result.proposal as Proposal, quote = result.quote as Offer;
+      if (value?.taskId !== packet.taskId || value.jobId !== packet.jobId || value.assets?.length !== packet.assets.length
+        || !Number.isSafeInteger(quote?.pricing?.amountMicros) || quote.pricing.amountMicros < 1
+        || quote.pricing.amountMicros > 100_000_000) throw new Error('The scoped proposal could not be verified.');
+      setProposal(value); setOffer(quote); setCap((quote.pricing.amountMicros / 1_000_000).toFixed(6));
+    }).catch(reason => { if (!controller.signal.aborted) setError(reason instanceof Error ? reason.message : 'Unable to prepare this room.'); })
+      .finally(() => { if (!controller.signal.aborted) setBusy(false); });
+    return () => controller.abort();
+  }, [userId, orgId, sessionId, packet, reload]);
+  async function authorize(event: FormEvent) {
+    event.preventDefault();
+    if (busy || !approved || !proposal || !packet || !offer || !window.opener) return;
+    const amount = Number(cap), maximumMicros = Math.round(amount * 1_000_000);
+    if (!/^\d{1,3}(?:\.\d{1,6})?$/.test(cap) || !Number.isSafeInteger(maximumMicros)
+      || maximumMicros < offer.pricing.amountMicros || maximumMicros > 100_000_000) {
+      setError('Enter a cap at least as large as this quote, up to $100.'); return;
+    }
+    if (Date.parse(offer.expiresAt) <= Date.now()) { setError('The quote expired. Refresh the proposal before approving.'); return; }
+    const controller = new AbortController(); inFlight.current = controller; setBusy(true); setError('');
+    try {
+      const result = await bridge({ operation: 'grant', taskId: proposal.taskId, project: proposal.project, nodeId: proposal.nodeId,
+        maximumMicros, assets: proposal.assets, approved: true }, controller.signal);
+      if (controller.signal.aborted || result.taskId !== packet.taskId || result.recipeHash !== proposal.recipeHash
+        || result.maximumMicros !== maximumMicros || typeof result.token !== 'string') throw new Error('The grant response did not match this room.');
+      const grant = { token: result.token, expiresAt: result.expiresAt, taskId: proposal.taskId, project: proposal.project,
+        nodeId: proposal.nodeId, recipeHash: proposal.recipeHash, maximumMicros, assets: proposal.assets };
+      window.opener.postMessage({ type: 'eva-room-grant', nonce: packet.nonce, jobId: packet.jobId, grant }, allowedOrigin);
+      setDelivered(true);
+    } catch (reason) { if (!controller.signal.aborted) setError(reason instanceof Error ? reason.message : 'Authorization could not be completed.'); }
+    finally { if (!controller.signal.aborted) setBusy(false); }
+  }
+  return <AuthShell title="Connect this room to Shado" description="Approve one bounded video attempt using the exact photos in your EVA room." section="EVA CONNECTION" compact>
+    {!isLoaded ? <p role="status">Checking your Shado account…</p> : !userId
+      ? <SignIn routing="hash" signUpUrl="/join" forceRedirectUrl="/eva-room-authorize"/>
+      : <div className={styles.content}>
+        <p>Account: <strong>{user?.primaryEmailAddress?.emailAddress ?? 'Signed-in Shado account'}</strong></p>
+        <p className={styles.detail}>Connection: {allowedOrigin}</p>
+        {error && <p role="alert" className={styles.error}>{error}</p>}
+        {!packet && !error && <p role="status">Waiting for the room request from EVA…</p>}
+        {busy && !proposal && <p role="status">Preparing the frozen recipe and current price…</p>}
+        {proposal && offer && !delivered && <form onSubmit={event => void authorize(event)} className={styles.form}>
+          <p><strong>{packet?.assets.length} original photos · one 5-second video</strong><br/>Seedance 2.5 · 720p · silent · 16:9</p>
+          <details><summary>Review the single-room direction</summary><p>{proposal.prompt}</p></details>
+          <p>Current quote: <strong>${(offer.pricing.amountMicros / 1_000_000).toFixed(6)}</strong>. The video may contain errors or incomplete room coverage.</p>
+          <label className={styles.label} htmlFor="eva-cap">Maximum Shado charge (USD)</label>
+          <input id="eva-cap" className={styles.input} inputMode="decimal" value={cap}
+            onChange={event => { setCap(event.target.value); setApproved(false); }} disabled={busy} required/>
+          <label className={styles.check}><input type="checkbox" checked={approved} onChange={event => setApproved(event.target.checked)} disabled={busy}/>
+            <span>Allow EVA to upload these originals and request one video under this cap. I will start the attempt with Continue in EVA.</span></label>
+          <Button type="submit" disabled={!approved || busy}>{busy ? 'Authorizing…' : 'Authorize this room'}</Button>
+          <p className={styles.detail}>This permission expires in 15 minutes. No video is submitted from this page. Reconstruction has a separate cloud allowance.</p>
+        </form>}
+        {delivered && <p role="status">Authorization sent to EVA. Return to your room and choose Continue when ready.</p>}
+        {packet && !busy && !delivered && <Button type="button" variant="outline" onClick={() => setReload(value => value + 1)}>Refresh proposal</Button>}
+        <p className={styles.detail}><a href="/terms" target="_blank" rel="noreferrer">Review Shado terms</a>. Originals and outputs remain subject to Shado’s storage and provider policies.</p>
+      </div>}
+  </AuthShell>;
+}
