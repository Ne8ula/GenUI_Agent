@@ -0,0 +1,24 @@
+export function evaAllowedOrigin(value) {
+  let url;
+  try { url = new URL(value); } catch { throw new Error('The EVA authorization origin is not configured.'); }
+  if ((url.protocol !== 'https:' && !(url.protocol === 'http:' && ['localhost', '127.0.0.1', '[::1]'].includes(url.hostname)))
+    || url.username || url.password || url.pathname !== '/' || url.search || url.hash)
+    throw new Error('The EVA authorization origin must be an exact HTTPS or loopback origin.');
+  return url.origin;
+}
+export function parseEvaRoomPacket(value) {
+  const exact = (row, keys) => row && typeof row === 'object' && !Array.isArray(row)
+    && Object.keys(row).sort().join(',') === [...keys].sort().join(',');
+  const uuid = id => typeof id === 'string' && /^[a-f0-9]{8}-[a-f0-9]{4}-[1-8][a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$/i.test(id);
+  if (!exact(value, ['type', 'nonce', 'jobId', 'taskId', 'assets']) || value.type !== 'eva-room-request'
+    || typeof value.nonce !== 'string' || !/^[a-f0-9]{32,128}$/.test(value.nonce)
+    || !uuid(value.jobId) || !uuid(value.taskId) || !Array.isArray(value.assets)
+    || value.assets.length < 5 || value.assets.length > 7
+    || value.assets.some(asset => !exact(asset, ['id', 'sha256', 'size', 'mimeType'])
+      || typeof asset.id !== 'string' || !/^[A-Za-z0-9][A-Za-z0-9_-]{0,99}$/.test(asset.id)
+      || !/^[a-f0-9]{64}$/.test(asset.sha256) || !Number.isSafeInteger(asset.size) || asset.size < 1 || asset.size > 20 * 1024 * 1024
+      || !['image/jpeg', 'image/png', 'image/webp'].includes(asset.mimeType))
+    || new Set(value.assets.map(asset => asset.id)).size !== value.assets.length)
+    throw new Error('The room request must contain 5–7 distinct, checksummed photos and a fresh task identity.');
+  return structuredClone(value);
+}
