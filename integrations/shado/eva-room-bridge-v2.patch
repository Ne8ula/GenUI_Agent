@@ -0,0 +1,35 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createHash } from 'node:crypto';
+import { createEvaRoomProposal } from './eva-room-proposal';
+import { parseProject } from '../lib/project-store';
+import { canonicalize } from '../lib/project';
+import { prepareGeneration } from '../lib/generation-client';
+
+const fixture = () => ({ type: 'eva-room-request', nonce: 'a'.repeat(64),
+  jobId: '12345678-1234-4234-8234-123456789abc', taskId: 'abcdef12-1234-4234-8234-123456789abc',
+  assets: Array.from({ length: 5 }, (_, index) => ({ id: `photo-${index}`, sha256: String(index).repeat(64), size: 1024, mimeType: 'image/png' })) });
+test('real Shado project commands freeze five image references into one silent single-room recipe', async () => {
+  const input = fixture(), result = await createEvaRoomProposal(input), project = parseProject(result.project);
+  const prepared = await prepareGeneration(project, result.nodeId);
+  assert.equal(result.taskId, input.taskId);
+  assert.equal(project.nodes.filter(node => node.data.kind === 'generation').length, 1);
+  assert.equal(prepared.recipe.modelId, 'seedance-2.5-reference-to-video');
+  assert.equal(prepared.recipe.settings.generate_audio, 'false');
+  assert.equal(prepared.recipe.settings.duration, '5');
+  assert.equal(prepared.recipe.inputs.length, 5);
+  assert.deepEqual(prepared.recipe.inputs.map(item => [item.sourceId, item.version, item.order]),
+    input.assets.map((asset, index) => [asset.id, asset.id, index]));
+  assert.equal(result.recipeHash, createHash('sha256').update(canonicalize(prepared.recipe)).digest('hex'));
+  assert.match(prepared.recipe.prompt, /single room/);
+  assert.deepEqual(result.assets.map(item => item.sha256), input.assets.map(item => item.sha256));
+});
+test('reopened proposal keeps recipe and task identities, and rejects supplied authority', async () => {
+  const input = fixture();
+  const first = await createEvaRoomProposal(input), second = await createEvaRoomProposal(input);
+  assert.equal(first.recipeHash, second.recipeHash);
+  assert.equal(first.taskId, second.taskId);
+  assert.equal(first.project, second.project);
+  assert.equal(JSON.parse(first.project).savedAt, undefined);
+  await assert.rejects(createEvaRoomProposal({ ...input, ownerId: 'not-authorized' }));
+});
