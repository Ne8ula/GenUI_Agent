--- /dev/null
+++ b/src/app/api/eva-room-bridge/route.ts
@@ -0,0 +1,180 @@
+import { requireBillingIdentity } from '@/server/auth';
+import { clerkAccess, requireClerkIdentity } from '@/server/clerk';
+import { configuredClerk } from '@/server/clerk-config';
+import { clerkTermsAcceptance } from '@/server/terms-provider';
+import { organizationOwner } from '@/server/management-policy';
+import { errorResponse, identifier, objectValue, readBody, ServiceError } from '@/server/errors';
+import { EVA_GRANT_TTL_MS, EvaBridgeError, exact, bridgeKey, assetDescriptor, sha256, signGrant, verifyGrant, assertProjectBinding, assertOperation, assertQuotedGeneration } from '@/server/eva-room-grant.mjs';
+import { createGrantAuthority, createRecoveryAuthority } from '@/server/eva-room-authority.mjs';
+import { parseProject } from '@/lib/project-store';
+import { prepareGeneration } from '@/lib/generation-client';
+import { getModelDefinition } from '@/lib/model-catalog';
+import { parseRecipe, recipeHash } from '@/server/generation';
+import { generationMediaRequest } from '@/server/media';
+import { assertWorkspaceMediaAvailable } from '@/server/workspace-media-deletion-store';
+import { reserveBalanceMicros } from '@/server/balance';
+import { readBillingState } from '@/server/billing-read';
+import { requireStore } from '@/server/runtime';
+import { createServerQuote } from '@/server/server-quotes';
+import { publicGenerationQuote } from '@/server/public-generation-quote';
+import { acceptGenerationTask, publicGenerationTask, stopGenerationTask } from '@/server/generation-tasks';
+import { requireGenerationTasks, wakeGenerationTask } from '@/server/generation-task-runtime';
+import { createEvaRoomProposal } from '@/server/eva-room-proposal';
+
+export const runtime = 'nodejs';
+export const maxDuration = 120;
+const headers = { 'Cache-Control': 'private, no-store' };
+const secret = () => bridgeKey(process.env.SHADO_EVA_BRIDGE_SECRET);
+const fail = () => { throw new ServiceError('eva_scope_mismatch', 'This request is outside the approved EVA task.', 403); };
+type Descriptor = { sourceId: string; version: string; sha256: string; size: number; mimeType: string };
+
+async function prepared(value: unknown, node: unknown) {
+  if (typeof value !== 'string' || Buffer.byteLength(value) > 3_000_000) fail();
+  const project = parseProject(value as string), nodeId = identifier(node);
+  const generation = await prepareGeneration(project, nodeId);
+  const recipe = parseRecipe(generation.recipe);
+  if (getModelDefinition(recipe.modelId)?.outputKind !== 'video' || !recipe.inputs.length
+    || recipe.inputs.some(input => input.kind !== 'image')) fail();
+  return { project, recipe, nodeId };
+}
+async function delegated(request: Request) {
+  const authorization = request.headers.get('authorization') ?? '';
+  if (!authorization.startsWith('Bearer ')) fail();
+  const grant = verifyGrant(authorization.slice(7), secret());
+  const clerk = await (await clerkAccess()).require(grant.subject);
+  const config = configuredClerk();
+  if (!config) fail();
+  const ownerId = organizationOwner(clerk.id, clerk.organizationId, config!.organizationId);
+  const scopeKey = `clerk:${clerk.organizationId}:${clerk.id}`;
+  if (ownerId !== grant.ownerId || scopeKey !== grant.scopeKey) fail();
+  await (await clerkTermsAcceptance()).require(clerk.id);
+  const identity = { ownerId, scopeKey, role: clerk.organizationId === config!.organizationId ? clerk.role : 'member' as const };
+  return { grant, identity };
+}
+export async function GET() {
+  let configured = false;
+  try { secret(); configured = !!configuredClerk(); } catch { /* fail closed */ }
+  return Response.json({ ok: true, version: 2, configured, grantTtlMs: EVA_GRANT_TTL_MS,
+    operations: ['proposal', 'grant', 'media', 'quote', 'submit', 'status', 'stop', 'output'] }, { headers });
+}
+export async function POST(request: Request) {
+  try {
+    secret();
+    const body = objectValue(await readBody(request, 3_200_000, 20_000));
+    if (body.operation === 'proposal') {
+      exact(body, ['operation', 'packet']);
+      await requireClerkIdentity(request);
+      await requireBillingIdentity(request, true);
+      const proposal = await createEvaRoomProposal(body.packet);
+      return Response.json({ ok: true, proposal, next: 'upload-authorization' }, { headers });
+    }
+    if (body.operation === 'grant') {
+      exact(body, ['operation', 'phase', 'quoteId', 'taskId', 'project', 'nodeId', 'maximumMicros', 'assets', 'approved']);
+      if (body.approved !== true) fail();
+      // This is the only issuing path: a real same-origin Shado session.
+      const clerk = await requireClerkIdentity(request);
+      const identity = await requireBillingIdentity(request, true);
+      if (identity.scopeKey !== `clerk:${clerk.organizationId}:${clerk.id}`) fail();
+      const { project, recipe, nodeId } = await prepared(body.project, body.nodeId);
+      if (!Array.isArray(body.assets)) fail();
+      const assets: Descriptor[] = (body.assets as unknown[]).map(assetDescriptor);
+      if (assets.length !== new Set(recipe.inputs.map(i => `${i.sourceId}:${i.version}`)).size
+        || recipe.inputs.some(i => !assets.some(a => a.sourceId === i.sourceId && a.version === i.version))) fail();
+      if (body.phase === 'recovery' && (body.quoteId !== null || body.maximumMicros !== 0)) fail();
+      const authority = body.phase === 'recovery'
+        ? createRecoveryAuthority(await requireGenerationTasks().tasks.get(identity.ownerId, identifier(body.taskId)),
+          { taskId: body.taskId, ownerId: identity.ownerId, scopeKey: identity.scopeKey,
+            projectId: project.id, nodeId, recipeHash: recipeHash(recipe) })
+        : await createGrantAuthority({ phase: body.phase, quoteId: body.quoteId,
+        maximumMicros: body.maximumMicros, assets }, {
+        readAsset: async (descriptor: Descriptor) => {
+          await assertWorkspaceMediaAvailable(identity.ownerId, [descriptor.sourceId, descriptor.version], request.signal);
+          const media = await generationMediaRequest(identity.ownerId, { operation: 'prepare', asset: descriptor });
+          return 'asset' in media ? media.asset : null;
+        },
+        quote: async () => publicGenerationQuote(await createServerQuote(requireStore(), identity, recipe)),
+      });
+      const now = Date.now();
+      const grant = { v: 2, aud: 'shado-eva-room-v2', ...authority,
+        subject: { userId: clerk.id, sessionId: clerk.sessionId, organizationId: clerk.organizationId },
+        ownerId: identity.ownerId, scopeKey: identity.scopeKey, taskId: identifier(body.taskId), projectId: project.id, nodeId,
+        projectHash: sha256(body.project), recipeHash: recipeHash(recipe),
+        assets, iat: now, exp: now + EVA_GRANT_TTL_MS };
+      return Response.json({ ok: true, token: signGrant(grant, secret()), expiresAt: grant.exp,
+        taskId: grant.taskId, recipeHash: grant.recipeHash, ...authority }, { headers });
+    }
+    const { grant, identity } = await delegated(request);
+    assertOperation(grant, body.operation);
+    if (body.operation === 'media') {
+      exact(body, ['operation', 'assetIndex', 'request']);
+      if (!Number.isInteger(body.assetIndex) || Number(body.assetIndex) < 0 || Number(body.assetIndex) >= grant.assets.length) fail();
+      const descriptor: Descriptor = grant.assets[Number(body.assetIndex)];
+      const media = objectValue(body.request);
+      if (!['prepare', 'chunk', 'seal', 'describe'].includes(String(media.operation))) fail();
+      exact(media, media.operation === 'prepare' ? ['operation'] : media.operation === 'chunk'
+        ? ['operation', 'assetId', 'index', 'base64'] : ['operation', 'assetId']);
+      await assertWorkspaceMediaAvailable(identity.ownerId, [descriptor.sourceId, descriptor.version], request.signal);
+      reserveBalanceMicros(await readBillingState(requireStore(), identity.ownerId), identity, 'generation', 1);
+      // Resolve the exact immutable owner-bound upload each time. Never trust a supplied asset ID.
+      const preparedMedia = await generationMediaRequest(identity.ownerId, { operation: 'prepare', asset: descriptor });
+      if (media.operation === 'prepare') {
+        return Response.json(preparedMedia, { headers });
+      }
+      if (!('asset' in preparedMedia) || !preparedMedia.asset || media.assetId !== preparedMedia.asset.id) fail();
+      return Response.json(await generationMediaRequest(identity.ownerId, media), { headers });
+    }
+    if (body.operation === 'quote' || body.operation === 'submit') {
+      exact(body, body.operation === 'quote' ? ['operation', 'project', 'nodeId']
+        : ['operation', 'project', 'nodeId', 'quoteId', 'recipeHash', 'maximumMicros']);
+      const { project, recipe, nodeId } = await prepared(body.project, body.nodeId);
+      assertProjectBinding(grant, body.project, project.id, nodeId, recipeHash(recipe));
+      if (body.operation === 'quote') {
+        const quote = publicGenerationQuote(await createServerQuote(requireStore(), identity, recipe));
+        return Response.json({ ok: true, quote }, { headers });
+      }
+      if (body.recipeHash !== grant.recipeHash) fail();
+      assertQuotedGeneration(grant, body.quoteId, body.maximumMicros);
+      // The project names immutable versions; the grant additionally pins their bytes.
+      // A caller cannot skip upload and spend against a different existing original.
+      for (const descriptor of grant.assets as Descriptor[]) {
+        await assertWorkspaceMediaAvailable(identity.ownerId, [descriptor.sourceId, descriptor.version], request.signal);
+        const media = await generationMediaRequest(identity.ownerId, { operation: 'prepare', asset: descriptor });
+        if (!('asset' in media) || !media.asset?.sealed || media.asset.sha256 !== descriptor.sha256
+          || media.asset.size !== descriptor.size || media.asset.mimeType !== descriptor.mimeType) fail();
+      }
+      const task = await acceptGenerationTask(requireGenerationTasks({ admission: true }), identity, {
+        id: grant.taskId, project: body.project, nodeIds: [nodeId], count: 1, approved: true,
+        quotes: [{ nodeId, quoteId: identifier(body.quoteId), recipeHash: body.recipeHash, maximumMicros: body.maximumMicros }],
+        admitBefore: Math.min(grant.exp, Date.now() + 120_000),
+      });
+      wakeGenerationTask(identity.ownerId, task.id);
+      return Response.json({ ok: true, task: publicGenerationTask(task) }, { status: 202, headers });
+    }
+    if (body.operation === 'status' || body.operation === 'stop' || body.operation === 'output') {
+      exact(body, body.operation === 'output' ? ['operation', 'assetId', 'index'] : ['operation']);
+      const deps = requireGenerationTasks();
+      const task = await deps.tasks.get(identity.ownerId, grant.taskId);
+      if (!task) return Response.json({ ok: true, task: null }, { headers });
+      if (task.projectId !== grant.projectId || task.manifest.scopeKey !== grant.scopeKey) fail();
+      const offers = task.manifest.quotes;
+      if (task.manifest.count !== 1 || !Array.isArray(offers) || offers.length !== 1
+        || offers[0]?.nodeId !== grant.nodeId || offers[0]?.recipeHash !== grant.recipeHash) fail();
+      if (body.operation === 'stop') return Response.json({ ok: true,
+        task: publicGenerationTask(await stopGenerationTask(deps, identity, task.id)) }, { headers });
+      const view = publicGenerationTask(task);
+      if (body.operation === 'status') return Response.json({ ok: true, task: view }, { headers });
+      // Receipt-bound original bytes only; never proxy an arbitrary URL or account asset.
+      const allowed = view.receipts.filter(receipt => receipt.recipeHash === grant.recipeHash && receipt.nodeId === grant.nodeId)
+        .flatMap(receipt => receipt.outputs.map(output => output.id));
+      if (!allowed.includes(String(body.assetId))) fail();
+      await assertWorkspaceMediaAvailable(identity.ownerId, [String(body.assetId)], request.signal);
+      return Response.json(await generationMediaRequest(identity.ownerId, body.index === null
+        ? { operation: 'describe', assetId: body.assetId }
+        : { operation: 'read', assetId: body.assetId, index: body.index }), { headers });
+    }
+    fail();
+  } catch (error) {
+    return errorResponse(error instanceof EvaBridgeError
+      ? new ServiceError(error.code, error.message, 403) : error);
+  }
+}
