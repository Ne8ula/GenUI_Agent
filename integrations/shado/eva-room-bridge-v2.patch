@@ -0,0 +1,37 @@
+import { createHash } from 'node:crypto';
+import { applyCommand, canonicalize, createEmptyProject, createGenerationNode } from '@/lib/project';
+import { serializeProject } from '@/lib/project-store';
+import { prepareGeneration } from '@/lib/generation-client';
+import { parseEvaRoomPacket } from '@/lib/eva-room-handoff.mjs';
+
+export const EVA_ROOM_PROMPT = 'Use all reference photographs as views of the same single room. Create one continuous, slow camera move within that room, preserving furniture, openings, wall layout, proportions, materials and object identity as consistently as possible. Show modest lateral movement and changes in viewing angle, without cuts, scene changes, added rooms or invented furniture. Stay inside the selected room. Do not travel through doors or windows or reveal a corridor, adjoining room or exterior. Keep doors and windows as boundaries. The result is a generated visual comparison, not calibrated geometry or evidence of unobserved surfaces.';
+
+/** Data-only proposal. No upload, quote, provider request or generation. */
+export async function createEvaRoomProposal(value: unknown) {
+  const packet = parseEvaRoomPacket(value);
+  let project = createEmptyProject('EVA · single-room comparison');
+  project.id = `eva-${packet.jobId}`;
+  const node = createGenerationNode('seedance-2.5-reference-to-video', { x: 420, y: 0 }, 'Room comparison');
+  node.id = 'eva-room-video';
+  node.data.settings = { ...node.data.settings, prompt: EVA_ROOM_PROMPT, duration: '5', resolution: '720p', aspect_ratio: '16:9', generate_audio: 'false' };
+  project = applyCommand(project, { type: 'add_node', node });
+  const assets: Array<{ sourceId: string; version: string; sha256: string; size: number; mimeType: string }> =
+    packet.assets.map((asset: { id: string; sha256: string; size: number; mimeType: string }, index: number) => {
+    const inputId = `eva-photo-${index}`, title = `Room photograph ${index + 1}`;
+    project = applyCommand(project, { type: 'add_asset', asset: { id: asset.id, assetId: asset.id, revision: 1,
+      kind: 'image', title, mimeType: asset.mimeType, url: `media:${asset.id}` } });
+    project = applyCommand(project, { type: 'add_node', node: { id: inputId, type: 'input', position: { x: 0, y: index * 180 },
+      data: { kind: 'input', title, assetVersionId: asset.id } } });
+    project = applyCommand(project, { type: 'connect', connection: { source: inputId, target: node.id,
+      targetHandle: 'reference-images', versionId: asset.id, edgeId: `eva-reference-${index}`, order: index } });
+    return { sourceId: asset.id, version: asset.id, sha256: asset.sha256, size: asset.size, mimeType: asset.mimeType };
+  });
+  const recipe = (await prepareGeneration(project, node.id)).recipe;
+  // A bridge proposal is a frozen recipe, not a user save event. Remove the
+  // serializer's wall-clock timestamp so same-task reconnection preserves bytes.
+  const envelope = JSON.parse(serializeProject(project));
+  delete envelope.savedAt;
+  return { project: JSON.stringify(envelope), projectId: project.id, nodeId: node.id, taskId: packet.taskId,
+    jobId: packet.jobId, assets, recipe, recipeHash: createHash('sha256').update(canonicalize(recipe)).digest('hex'), prompt: EVA_ROOM_PROMPT,
+    modelId: recipe.modelId, settings: recipe.settings };
+}
