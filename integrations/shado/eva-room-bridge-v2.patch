diff --git a/src/server/eva-room-authority.mjs b/src/server/eva-room-authority.mjs
new file mode 100644
--- /dev/null
+++ b/src/server/eva-room-authority.mjs
@@ -0,0 +1,36 @@
+import { EvaBridgeError } from './eva-room-grant.mjs';
+
+/** Existing task recovery is deliberately incapable of creating or resuming work. */
+export function createRecoveryAuthority(task, binding) {
+  const offers = task?.manifest?.quotes;
+  if (!task || task.id !== binding.taskId || task.ownerId !== binding.ownerId
+    || task.projectId !== binding.projectId || task.manifest?.scopeKey !== binding.scopeKey
+    || task.manifest?.count !== 1 || !Array.isArray(offers) || offers.length !== 1
+    || offers[0]?.nodeId !== binding.nodeId || offers[0]?.recipeHash !== binding.recipeHash)
+    throw new EvaBridgeError('No matching existing room task is available for recovery.');
+  return { phase: 'recovery', quoteId: null, maximumMicros: 0 };
+}
+
+/** Called only after same-origin user authentication and project/asset validation.
+ * Upload permission cannot spend. Generation permission follows sealed metadata. */
+export async function createGrantAuthority(request, { readAsset, quote }) {
+  const { phase, quoteId, maximumMicros, assets } = request;
+  if (phase === 'upload') {
+    if (quoteId !== null || maximumMicros !== 0) throw new EvaBridgeError();
+    return { phase, quoteId: null, maximumMicros: 0 };
+  }
+  if (phase !== 'generation' || typeof quoteId !== 'string'
+    || !Number.isSafeInteger(maximumMicros) || maximumMicros < 1 || maximumMicros > 100_000_000)
+    throw new EvaBridgeError();
+  for (const descriptor of assets) {
+    const media = await readAsset(descriptor);
+    if (!media?.sealed || ['sourceId', 'version', 'sha256', 'size', 'mimeType'].some(key => media[key] !== descriptor[key]))
+      throw new EvaBridgeError('Upload and seal the exact originals before generation authorization.');
+  }
+  // The real quote implementation obtains metadata from owner-bound sealed manifests.
+  const offer = await quote();
+  if (offer.id !== quoteId || offer.pricing?.amountMicros !== maximumMicros
+    || !Number.isFinite(Date.parse(offer.expiresAt)) || Date.parse(offer.expiresAt) <= Date.now())
+    throw new EvaBridgeError('Review the current sealed-input quote before authorizing generation.');
+  return { phase, quoteId, maximumMicros };
+}
diff --git a/src/server/eva-room-authority.test.mjs b/src/server/eva-room-authority.test.mjs
