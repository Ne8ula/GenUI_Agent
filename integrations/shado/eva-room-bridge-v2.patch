+++ b/src/server/eva-room-authority.test.mjs
@@ -0,0 +1,43 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createGrantAuthority, createRecoveryAuthority } from './eva-room-authority.mjs';
+const asset = { sourceId: 'photo-1', version: 'v1', sha256: 'a'.repeat(64), size: 1024, mimeType: 'image/jpeg' };
+const upload = { phase: 'upload', quoteId: null, maximumMicros: 0, assets: [asset] };
+const generation = { ...upload, phase: 'generation', quoteId: 'quote-1', maximumMicros: 500_000 };
+const offer = () => ({ id: 'quote-1', pricing: { amountMicros: 500_000 }, expiresAt: new Date(Date.now() + 60_000).toISOString() });
+test('recovery requires the exact existing owner/task/project/scope/recipe and grants no spending', () => {
+  const binding = { taskId: 'task-1', ownerId: 'owner-1', projectId: 'project-1', scopeKey: 'scope-1', nodeId: 'node-1', recipeHash: 'a'.repeat(64) };
+  const task = { id: binding.taskId, ownerId: binding.ownerId, projectId: binding.projectId,
+    state: { status: 'failed' }, manifest: { scopeKey: binding.scopeKey, count: 1, quotes: [{ nodeId: binding.nodeId, recipeHash: binding.recipeHash }] } };
+  assert.deepEqual(createRecoveryAuthority(task, binding), { phase: 'recovery', quoteId: null, maximumMicros: 0 });
+  assert.throws(() => createRecoveryAuthority(null, binding));
+  for (const key of Object.keys(binding)) assert.throws(() => createRecoveryAuthority(task, { ...binding, [key]: 'other' }));
+  assert.throws(() => createRecoveryAuthority({ ...task, manifest: { ...task.manifest, count: 2 } }, binding));
+});
+test('upload grant does not request quote or metadata and has zero spending authority', async () => {
+  const unexpected = () => { throw Error('Must not run'); };
+  assert.deepEqual(await createGrantAuthority(upload, { readAsset: unexpected, quote: unexpected }),
+    { phase: 'upload', quoteId: null, maximumMicros: 0 });
+  await assert.rejects(createGrantAuthority({ ...upload, maximumMicros: 1 }, {}));
+});
+test('unsealed or mismatched originals cannot reach quote creation', async () => {
+  for (const media of [null, { ...asset, sealed: false }, { ...asset, sealed: true, sha256: 'b'.repeat(64) },
+    { ...asset, sealed: true, sourceId: 'other' }]) {
+    let quoted = false;
+    await assert.rejects(createGrantAuthority(generation, { readAsset: async () => media, quote: async () => { quoted = true; return offer(); } }));
+    assert.equal(quoted, false);
+  }
+});
+test('sealed originals precede real quote and generation authority binds exact offer', async () => {
+  const calls = [];
+  const result = await createGrantAuthority(generation, {
+    readAsset: async descriptor => { calls.push('sealed'); return { ...descriptor, sealed: true }; },
+    quote: async () => { calls.push('quote'); return offer(); },
+  });
+  assert.deepEqual(calls, ['sealed', 'quote']);
+  assert.deepEqual(result, { phase: 'generation', quoteId: 'quote-1', maximumMicros: 500_000 });
+  for (const changed of [{ ...offer(), id: 'quote-2' }, { ...offer(), pricing: { amountMicros: 499_999 } },
+    { ...offer(), expiresAt: new Date(0).toISOString() }]) {
+    await assert.rejects(createGrantAuthority(generation, { readAsset: async () => ({ ...asset, sealed: true }), quote: async () => changed }));
+  }
+});
diff --git a/src/lib/eva-room-authorization.mjs b/src/lib/eva-room-authorization.mjs
new file mode 100644
--- /dev/null
+++ b/src/lib/eva-room-authorization.mjs
@@ -0,0 +1,110 @@
+import { evaAllowedOrigin, parseEvaRoomPacket } from './eva-room-handoff.mjs';
+
+const identifier = value => typeof value === 'string' && /^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$/.test(value);
+const exact = (value, keys) => value && typeof value === 'object' && !Array.isArray(value)
+  && Object.keys(value).sort().join(',') === [...keys].sort().join(',');
+const canonical = value => Array.isArray(value) ? `[${value.map(canonical).join(',')}]`
+  : value && typeof value === 'object' ? `{${Object.entries(value).sort(([a], [b]) => a.localeCompare(b)).map(([key, item]) => `${JSON.stringify(key)}:${canonical(item)}`).join(',')}}`
+    : JSON.stringify(value);
+const fail = message => { throw new Error(message); };
+
+/** Ephemeral popup state only. This controller never uploads, submits or persists.
+ * Identity is a local continuity guard; the server authenticates every issuance. */
+export function createEvaRoomAuthorization({ packet: input, proposal: offered, identity,
+  uploadNonce, allowedOrigin, opener, now = Date.now }) {
+  const packet = parseEvaRoomPacket(input), proposal = structuredClone(offered);
+  const origin = evaAllowedOrigin(allowedOrigin);
+  if (!identity || !opener || typeof uploadNonce !== 'string' || !/^[a-f0-9]{64}$/.test(uploadNonce)
+    || !proposal || proposal.taskId !== packet.taskId || proposal.jobId !== packet.jobId
+    || !identifier(proposal.nodeId) || !identifier(proposal.projectId)
+    || proposal.modelId !== 'seedance-2.5-reference-to-video'
+    || proposal.settings?.duration !== '5' || proposal.settings?.resolution !== '720p'
+    || proposal.settings?.aspect_ratio !== '16:9' || proposal.settings?.generate_audio !== 'false'
+    || !/^[a-f0-9]{64}$/.test(proposal.recipeHash) || typeof proposal.project !== 'string'
+    || proposal.project.length > 3_000_000 || !Array.isArray(proposal.assets)
+    || proposal.assets.length !== packet.assets.length
+    || proposal.assets.some((asset, index) => {
+      const original = packet.assets[index];
+      return !exact(asset, ['sourceId', 'version', 'sha256', 'size', 'mimeType'])
+        || asset.sourceId !== original.id || asset.version !== original.id
+        || asset.sha256 !== original.sha256 || asset.size !== original.size || asset.mimeType !== original.mimeType;
+    })) fail('The scoped proposal does not match the selected originals.');
+  let state = 'ready', offer = null;
+  const check = currentIdentity => {
+    if (state === 'denied') fail('This authorization was declined. Reopen the same room to reconnect.');
+    if (currentIdentity !== identity) fail('The signed-in account or session changed. Reconnect this same room.');
+  };
+  const request = (phase, quoteId, maximumMicros) => ({ operation: 'grant', phase, quoteId, maximumMicros,
+    taskId: packet.taskId, project: proposal.project, nodeId: proposal.nodeId, assets: structuredClone(proposal.assets), approved: true });
+  function accepted(result, phase, quoteId, amount, currentIdentity) {
+    check(currentIdentity);
+    if (state !== `${phase}-requesting` || result?.ok !== true || result.phase !== phase || result.quoteId !== quoteId
+      || result.taskId !== packet.taskId || result.recipeHash !== proposal.recipeHash || result.maximumMicros !== amount
+      || typeof result.token !== 'string' || result.token.length > 16384 || !/^[A-Za-z0-9_-]+\.[A-Za-z0-9_-]{43}$/.test(result.token)
+      || !Number.isSafeInteger(result.expiresAt) || result.expiresAt <= now() || result.expiresAt > now()+15*60_000+30_000)
+      fail('The grant response does not match this room and authorization phase.');
+    state = phase === 'upload' ? 'awaiting-quote' : 'delivered';
+    return { type: 'eva-room-grant', nonce: packet.nonce, jobId: packet.jobId, uploadNonce,
+      grant: { token: result.token, expiresAt: result.expiresAt, phase, quoteId, maximumMicros: amount,
+        taskId: packet.taskId, project: proposal.project, nodeId: proposal.nodeId, recipeHash: proposal.recipeHash,
+        assets: structuredClone(proposal.assets) } };
+  }
+  return Object.freeze({
+    state: () => state,
+    uploadRequest(approved, currentIdentity) {
+      check(currentIdentity);
+      if (packet.type !== 'eva-room-request' || state !== 'ready' || approved !== true) fail('Approve upload of the selected originals first.');
+      state = 'upload-requesting';
+      return request('upload', null, 0);
+    },
+    recoveryRequest(approved, currentIdentity) {
+      check(currentIdentity);
+      if (packet.type !== 'eva-room-recovery-request' || state !== 'ready' || approved !== true)
+        fail('Approve recovery of this existing room task first.');
+      state = 'recovery-requesting';
+      return request('recovery', null, 0);
+    },
+    acceptRecovery(result, currentIdentity) { return accepted(result, 'recovery', null, 0, currentIdentity); },
+    acceptUpload(result, currentIdentity) { return accepted(result, 'upload', null, 0, currentIdentity); },
+    async receiveQuote(event, currentIdentity) {
+      check(currentIdentity);
+      if (event.origin !== origin || event.source !== opener || state !== 'awaiting-quote')
+        fail('The quote did not arrive through the active EVA connection.');
+      const value = event.data;
+      if (!exact(value, ['type', 'nonce', 'jobId', 'taskId', 'recipeHash', 'uploadNonce', 'quote'])
+        || value.type !== 'eva-room-quote' || value.nonce !== packet.nonce || value.jobId !== packet.jobId
+        || value.taskId !== packet.taskId || value.recipeHash !== proposal.recipeHash || value.uploadNonce !== uploadNonce)
+        fail('The quote belongs to another room, task or upload authorization.');
+      const quote = structuredClone(value.quote);
+      if (!quote || JSON.stringify(quote).length > 3_200_000 || !identifier(quote.id)
+        || quote.recipeHash !== proposal.recipeHash || quote.currency !== 'USD'
+        || quote.recipe?.projectId !== proposal.projectId || quote.recipe?.nodeId !== proposal.nodeId
+        || quote.recipe?.modelId !== proposal.modelId
+        || !Number.isSafeInteger(quote.pricing?.amountMicros) || quote.pricing.amountMicros < 1
+        || quote.pricing.amountMicros > 100_000_000 || quote.maximumCostUsd !== quote.pricing.amountMicros/1_000_000
+        || !Number.isFinite(Date.parse(quote.expiresAt)) || Date.parse(quote.expiresAt) <= now())
+        fail('The quote is invalid or expired. Reconnect this same room to refresh it.');
+      const digest = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(canonical(quote.recipe)));
+      if (Array.from(new Uint8Array(digest), byte => byte.toString(16).padStart(2, '0')).join('') !== proposal.recipeHash)
+        fail('The quote recipe differs from the frozen room proposal.');
+      check(currentIdentity);
+      if (state !== 'awaiting-quote') fail('This quote request is no longer active.');
+      offer = structuredClone(quote); state = 'quote-ready';
+      return structuredClone(offer);
+    },
+    generationRequest(approved, currentIdentity) {
+      check(currentIdentity);
+      if (state !== 'quote-ready' || approved !== true || Date.parse(offer.expiresAt) <= now())
+        fail('Review and approve the current sealed-input quote first.');
+      state = 'generation-requesting';
+      return request('generation', offer.id, offer.pricing.amountMicros);
+    },
+    acceptGeneration(result, currentIdentity) {
+      return accepted(result, 'generation', offer?.id, offer?.pricing.amountMicros, currentIdentity);
+    },
+    failed(phase) {
+      if (state === `${phase}-requesting`) state = phase === 'generation' ? 'quote-ready' : 'ready';
+    },
+    deny() { state = 'denied'; offer = null; },
+  });
+}
diff --git a/src/lib/eva-room-authorization.test.mjs b/src/lib/eva-room-authorization.test.mjs
new file mode 100644
--- /dev/null
+++ b/src/lib/eva-room-authorization.test.mjs
@@ -0,0 +1,104 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createHash } from 'node:crypto';
+import { createEvaRoomAuthorization } from './eva-room-authorization.mjs';
+
+const now = 1_800_000_000_000, identity = 'user1:org1:session1', origin = 'http://127.0.0.1:1440', opener = {};
+const packet = () => ({ type: 'eva-room-request', nonce: 'a'.repeat(64), jobId: '12345678-1234-4234-8234-123456789abc',
+  taskId: 'abcdef12-1234-4234-8234-123456789abc',
+  assets: Array.from({ length: 5 }, (_, index) => ({ id: `photo-${index}`, sha256: String(index).repeat(64), size: 100, mimeType: 'image/png' })) });
+const recipe = { modelId: 'seedance-2.5-reference-to-video', nodeId: 'video-1', projectId: 'project-1' };
+const recipeHash = createHash('sha256').update(JSON.stringify(recipe)).digest('hex');
+const proposal = () => ({ taskId: packet().taskId, jobId: packet().jobId, nodeId: 'video-1', projectId: 'project-1',
+  modelId: recipe.modelId, settings: { duration: '5', resolution: '720p', aspect_ratio: '16:9', generate_audio: 'false' },
+  recipeHash, project: JSON.stringify({ format: 'shado-project', version: 1, project: { id: 'project-1' } }),
+  assets: packet().assets.map(({ id, ...rest }) => ({ sourceId: id, version: id, ...rest })) });
+const uploadNonce = 'b'.repeat(64);
+const quote = () => ({ id: 'quote-1', recipe, recipeHash, currency: 'USD', maximumCostUsd: .5,
+  pricing: { amountMicros: 500_000 }, expiresAt: new Date(now + 60_000).toISOString() });
+const event = () => ({ origin, source: opener, data: { type: 'eva-room-quote', nonce: packet().nonce, jobId: packet().jobId,
+  taskId: packet().taskId, recipeHash, uploadNonce, quote: quote() } });
+const receipt = phase => ({ ok: true, phase, quoteId: phase === 'generation' ? 'quote-1' : null,
+  maximumMicros: phase === 'generation' ? 500_000 : 0, taskId: packet().taskId, recipeHash,
+  token: `fixture.${'c'.repeat(43)}`, expiresAt: now+900_000 });
+const flow = (options = {}) => createEvaRoomAuthorization({ packet: packet(), proposal: proposal(), identity, uploadNonce,
+  allowedOrigin: origin, opener, now: () => now, ...options });
+function uploaded() {
+  const active = flow();
+  active.uploadRequest(true, identity); active.acceptUpload(receipt('upload'), identity);
+  return active;
+}
+
+test('upload and generation each require consent, and only a sealed-input quote enables generation phase', async () => {
+  const active = flow();
+  assert.throws(() => active.uploadRequest(false, identity));
+  assert.throws(() => active.generationRequest(true, identity));
+  const upload = active.uploadRequest(true, identity);
+  assert.equal(upload.maximumMicros, 0); assert.equal(upload.quoteId, null);
+  const grant = active.acceptUpload(receipt('upload'), identity);
+  assert.equal(grant.uploadNonce, uploadNonce); assert.equal(grant.grant.phase, 'upload');
+  assert.equal(active.state(), 'awaiting-quote');
+  const offered = await active.receiveQuote(event(), identity);
+  offered.pricing.amountMicros = 1;
+  assert.throws(() => active.generationRequest(false, identity));
+  const request = active.generationRequest(true, identity);
+  assert.equal(request.maximumMicros, 500_000); assert.equal(request.quoteId, 'quote-1');
+  assert.deepEqual(request.assets, upload.assets);
+  assert.equal(request.project, upload.project);
+  assert.equal(request.taskId, upload.taskId);
+  assert.equal(active.acceptGeneration(receipt('generation'), identity).grant.phase, 'generation');
+  assert.throws(() => active.generationRequest(true, identity));
+});
+test('cross-origin/source, stale reconnect nonce and changed task/recipe quote packets reject', async () => {
+  for (const change of [e => e.origin = 'https://evil.example', e => e.source = {},
+    e => e.data.nonce = 'f'.repeat(64), e => e.data.uploadNonce = 'd'.repeat(64), e => e.data.taskId = packet().jobId,
+    e => e.data.recipeHash = 'e'.repeat(64), e => e.data.ownerId = 'victim']) {
+    const incoming = event(); change(incoming);
+    await assert.rejects(uploaded().receiveQuote(incoming, identity));
+  }
+});
+test('expired, inconsistent-price and modified recipe quotes cannot enable generation', async () => {
+  for (const change of [q => q.expiresAt = new Date(now).toISOString(),
+    q => q.pricing.amountMicros = 100_000_001, q => q.maximumCostUsd = .1,
+    q => q.recipe = { ...q.recipe, extra: 'changed' }]) {
+    const incoming = event(); change(incoming.data.quote);
+    const active = uploaded();
+    await assert.rejects(active.receiveQuote(incoming, identity));
+    assert.throws(() => active.generationRequest(true, identity));
+  }
+});
+test('account/session changes, denial and mismatched grant receipts fail closed', async () => {
+  const active = uploaded();
+  await assert.rejects(active.receiveQuote(event(), 'user1:org1:newsession'));
+  active.deny();
+  await assert.rejects(active.receiveQuote(event(), identity));
+  assert.throws(() => active.generationRequest(true, identity));
+  for (const change of [r => r.phase = 'generation', r => r.maximumMicros = 1,
+    r => r.recipeHash = 'f'.repeat(64), r => r.expiresAt = now]) {
+    const candidate = flow(), result = receipt('upload');
+    candidate.uploadRequest(true, identity); change(result);
+    assert.throws(() => candidate.acceptUpload(result, identity));
+  }
+});
+test('reopening keeps task/assets/project while issuing a fresh upload nonce', async () => {
+  const original = flow(), renewed = flow({ uploadNonce: 'd'.repeat(64) });
+  assert.deepEqual(original.uploadRequest(true, identity), renewed.uploadRequest(true, identity));
+  const old = original.acceptUpload(receipt('upload'), identity), next = renewed.acceptUpload(receipt('upload'), identity);
+  assert.notEqual(old.uploadNonce, next.uploadNonce);
+  await assert.rejects(renewed.receiveQuote(event(), identity));
+});
+test('recovery request has zero spending authority and cannot upload or quote', async () => {
+  const active = flow({ packet: { ...packet(), type: 'eva-room-recovery-request' } });
+  assert.throws(() => active.uploadRequest(true, identity));
+  assert.throws(() => active.recoveryRequest(false, identity));
+  const request = active.recoveryRequest(true, identity);
+  assert.equal(request.phase, 'recovery'); assert.equal(request.maximumMicros, 0); assert.equal(request.quoteId, null);
+  assert.equal(active.acceptRecovery(receipt('recovery'), identity).grant.phase, 'recovery');
+  await assert.rejects(active.receiveQuote(event(), identity));
+  assert.throws(() => active.generationRequest(true, identity));
+});
+test('wrong original bytes or static display settings reject before user consent', () => {
+  const wrongAssets = proposal(); wrongAssets.assets[0].sha256 = 'e'.repeat(64);
+  assert.throws(() => flow({ proposal: wrongAssets }));
+  assert.throws(() => flow({ proposal: { ...proposal(), settings: { ...proposal().settings, duration: '30' } } }));
+});
