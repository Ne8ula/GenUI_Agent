+++ b/src/app/eva-room-authorize/authorize-room.tsx
@@ -0,0 +1,153 @@
+'use client';
+
+import { useEffect, useRef, useState, type FormEvent } from 'react';
+import { SignIn, useAuth, useUser } from '@clerk/nextjs';
+import { AuthShell } from '@/components/clerk-auth';
+import { Button } from '@/components/ui/button';
+import { parseEvaRoomPacket } from '@/lib/eva-room-handoff.mjs';
+import { createEvaRoomAuthorization } from '@/lib/eva-room-authorization.mjs';
+import styles from './authorize-room.module.css';
+
+type Packet = { type: string; nonce: string; jobId: string; taskId: string;
+  assets: Array<{ id: string; sha256: string; size: number; mimeType: string }> };
+type Proposal = { project: string; projectId: string; nodeId: string; taskId: string; jobId: string; recipeHash: string; prompt: string;
+  modelId: string; settings: Record<string, string>;
+  assets: Array<{ sourceId: string; version: string; sha256: string; size: number; mimeType: string }> };
+type Offer = { id: string; maximumCostUsd: number; pricing: { amountMicros: number }; expiresAt: string };
+
+type Flow = ReturnType<typeof createEvaRoomAuthorization>;
+
+async function bridge(body: unknown, signal: AbortSignal) {
+  const response = await fetch('/api/eva-room-bridge', { method: 'POST', redirect: 'error', credentials: 'same-origin',
+    headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body),
+    signal: AbortSignal.any([signal, AbortSignal.timeout(30_000)]) });
+  const text = await response.text();
+  if (text.length > 3_200_000) throw new Error('The authorization response is too large.');
+  let result;
+  try { result = JSON.parse(text); } catch { throw new Error('Shado could not confirm the authorization request.'); }
+  if (!response.ok || result.ok !== true) throw new Error(typeof result.error?.message === 'string'
+    ? result.error.message : 'Shado could not verify this room request.');
+  return result;
+}
+
+export default function AuthorizeRoom({ allowedOrigin }: { allowedOrigin: string }) {
+  const { isLoaded, userId, orgId, sessionId } = useAuth(), { user } = useUser();
+  const received = useRef<Packet | null>(null), inFlight = useRef<AbortController | null>(null);
+  const flow = useRef<Flow | null>(null), identity = useRef(''), activeUploadNonce = useRef<string | null>(null);
+  identity.current = userId && orgId && sessionId ? `${userId}:${orgId}:${sessionId}` : '';
+  const [packet, setPacket] = useState<Packet | null>(null), [proposal, setProposal] = useState<Proposal | null>(null);
+  const [offer, setOffer] = useState<Offer | null>(null), [approved, setApproved] = useState(false);
+  const [busy, setBusy] = useState(false), [stage, setStage] = useState('ready'), [error, setError] = useState('');
+  const [reload, setReload] = useState(0);
+  function invalidate() {
+    const original = received.current, uploadNonce = activeUploadNonce.current;
+    if (original && uploadNonce && window.opener) window.opener.postMessage({ type: 'eva-room-invalidated',
+      nonce: original.nonce, jobId: original.jobId, uploadNonce }, allowedOrigin);
+    activeUploadNonce.current = null;
+    flow.current?.deny(); flow.current = null;
+  }
+  useEffect(() => {
+    if (!window.opener) { setError('Open this authorization window from your EVA room.'); return; }
+    const receive = (event: MessageEvent) => {
+      if (event.origin !== allowedOrigin || event.source !== window.opener) return;
+      if (event.data?.type === 'eva-room-quote') {
+        const active = flow.current;
+        if (!active) return;
+        void active.receiveQuote(event, identity.current).then(value => {
+          if (flow.current !== active || active.state() !== 'quote-ready') return;
+          setOffer(value as Offer); setStage('quote-ready'); setApproved(false); setError('');
+        }).catch(reason => {
+          if (flow.current === active) setError(reason instanceof Error ? reason.message : 'The room quote could not be verified.');
+        });
+        return;
+      }
+      if (received.current) return;
+      try {
+        const value = parseEvaRoomPacket(event.data) as Packet;
+        received.current = value; setPacket(value); setError('');
+      } catch { setError('The EVA room request could not be verified. Close this window and reconnect from EVA.'); }
+    };
+    window.addEventListener('message', receive);
+    window.opener.postMessage({ type: 'eva-room-ready' }, allowedOrigin);
+    return () => { window.removeEventListener('message', receive); inFlight.current?.abort(); flow.current?.deny(); };
+  }, [allowedOrigin]);
+  useEffect(() => {
+    inFlight.current?.abort(); invalidate();
+    setProposal(null); setOffer(null); setApproved(false); setStage('ready'); setBusy(false);
+    if (!identity.current || !packet) return;
+    const controller = new AbortController(); inFlight.current = controller;
+    setBusy(true); setError('');
+    void bridge({ operation: 'proposal', packet }, controller.signal).then(result => {
+      if (controller.signal.aborted) return;
+      if (result.next !== 'upload-authorization' || result.quote !== undefined)
+        throw new Error('Shado requires the two-stage room authorization protocol.');
+      const value = result.proposal as Proposal;
+      const uploadNonce = Array.from(crypto.getRandomValues(new Uint8Array(32)), byte => byte.toString(16).padStart(2, '0')).join('');
+      flow.current = createEvaRoomAuthorization({ packet, proposal: value, identity: identity.current, uploadNonce,
+        allowedOrigin, opener: window.opener });
+      setProposal(value);
+    }).catch(reason => {
+      if (!controller.signal.aborted) setError(reason instanceof Error ? reason.message : 'Unable to prepare this room.');
+    }).finally(() => { if (!controller.signal.aborted) setBusy(false); });
+    return () => { controller.abort(); flow.current?.deny(); };
+  }, [userId, orgId, sessionId, packet, reload, allowedOrigin]);
+  async function authorize(event: FormEvent) {
+    event.preventDefault();
+    const active = flow.current;
+    if (busy || !approved || !active || !proposal || !packet || !window.opener) return;
+    const phase = packet.type === 'eva-room-recovery-request' ? 'recovery' : stage === 'ready' ? 'upload' : 'generation';
+    const controller = new AbortController(); inFlight.current = controller; setBusy(true); setError('');
+    try {
+      const request = phase === 'upload' ? active.uploadRequest(approved, identity.current)
+        : phase === 'recovery' ? active.recoveryRequest(approved, identity.current) : active.generationRequest(approved, identity.current);
+      const result = await bridge(request, controller.signal);
+      if (controller.signal.aborted || flow.current !== active) return;
+      const envelope = phase === 'upload' ? active.acceptUpload(result, identity.current)
+        : phase === 'recovery' ? active.acceptRecovery(result, identity.current) : active.acceptGeneration(result, identity.current);
+      activeUploadNonce.current = envelope.uploadNonce;
+      window.opener.postMessage(envelope, allowedOrigin);
+      setStage(active.state()); setApproved(false);
+    } catch (reason) {
+      active.failed(phase);
+      if (!controller.signal.aborted) setError(reason instanceof Error ? reason.message : 'Authorization could not be completed.');
+    } finally { if (!controller.signal.aborted) setBusy(false); }
+  }
+  function decline() {
+    inFlight.current?.abort(); invalidate(); setStage('denied'); setApproved(false); setBusy(false); setOffer(null);
+  }
+  return <AuthShell title="Connect this room to Shado" description="First authorize the selected photos, then review the verified video price." section="EVA CONNECTION" compact>
+    {!isLoaded ? <p role="status">Checking your Shado account...</p> : !userId
+      ? <SignIn routing="hash" signUpUrl="/join" forceRedirectUrl="/eva-room-authorize"/>
+      : <div className={styles.content}>
+        <p>Account: <strong>{user?.primaryEmailAddress?.emailAddress ?? 'Signed-in Shado account'}</strong></p>
+        <p className={styles.detail}>Connection: {allowedOrigin}</p>
+        {error && <p role="alert" className={styles.error}>{error}</p>}
+        {!packet && !error && <p role="status">Waiting for the room request from EVA...</p>}
+        {userId && !identity.current && <p role="status">Select your Shado organization to continue.</p>}
+        {busy && !proposal && <p role="status">Preparing the frozen room recipe...</p>}
+        {proposal && ['ready', 'quote-ready'].includes(stage) && <form onSubmit={event => void authorize(event)} className={styles.form}>
+          <p><strong>{packet?.assets.length} original photos; one 5-second video</strong><br/>Seedance 2.5; 720p; silent; 16:9</p>
+          <details><summary>Review the single-room direction</summary><p>{proposal.prompt}</p></details>
+          {packet?.type === 'eva-room-recovery-request' ? <p>Reconnect to the existing task to check its status, request cancellation or retrieve its completed video. This permission cannot upload, quote or generate anything.</p>
+            : stage === 'ready' ? <p>Shado needs the verified original files before it can quote this video. This first permission has no generation spending authority.</p>
+            : offer && <p>Verified video quote: <strong>${(offer.pricing.amountMicros / 1_000_000).toFixed(6)}</strong>. This exact amount is the maximum authorized charge. The generated room may contain errors or incomplete coverage.</p>}
+          <label className={styles.check}><input type="checkbox" checked={approved} onChange={event => setApproved(event.target.checked)} disabled={busy}/>
+            <span>{packet?.type === 'eva-room-recovery-request' ? 'Allow EVA to recover only this existing room task.'
+              : stage === 'ready' ? 'Allow EVA to upload these exact originals to Shado and obtain a quote.'
+              : 'Allow EVA to request this one video for the displayed exact quote. I will start the attempt with Continue in EVA.'}</span></label>
+          <Button type="submit" disabled={!approved || busy}>{busy ? 'Authorizing...' : packet?.type === 'eva-room-recovery-request'
+            ? 'Authorize task recovery' : stage === 'ready' ? 'Authorize photo upload' : 'Authorize quoted video'}</Button>
+          <p className={styles.detail}>Permissions last up to 15 minutes. This page never submits a video. Reconstruction has a separate cloud allowance.</p>
+        </form>}
+        {stage === 'awaiting-quote' && <p role="status">Upload permission sent. Return to EVA to transfer the originals, keeping this window open. The verified quote will appear here when ready.</p>}
+        {stage === 'delivered' && <p role="status">{packet?.type === 'eva-room-recovery-request'
+          ? 'Recovery permission sent to EVA. Return to your room to check or cancel the existing task.'
+          : 'Video authorization sent to EVA. Return to your room and choose Continue when ready.'}</p>}
+        {stage === 'denied' && <p role="status">Authorization declined. No video was requested by this page. Any originals already transferred remain subject to Shado's storage policy.</p>}
+        {packet && !busy && stage !== 'delivered' && <Button type="button" variant="outline" onClick={() => setReload(value => value + 1)}>Reconnect same room</Button>}
+        {packet && !busy && !['denied', 'delivered'].includes(stage) && <Button type="button" variant="outline" onClick={decline}>Decline and return to EVA</Button>}
+        <p className={styles.detail}>Closing this window does not submit a video. Reopen authorization from the same EVA room to resume; completed uploads can be reused.</p>
+        <p className={styles.detail}><a href="/terms" target="_blank" rel="noreferrer">Review Shado terms</a>. Originals and outputs remain subject to Shado's storage and provider policies.</p>
+      </div>}
+  </AuthShell>;
+}
