# Copy these NONSECRET values into the Claude Code Cloud environment's variables field.
EVA_NODE_VERSION=24.14.0
EVA_TOOLCHAIN_ROOT=/opt/eva-w3
PLAYWRIGHT_BROWSERS_PATH=/opt/eva-w3/ms-playwright
EVA_BROWSER_CHANNEL=chromium
EVA_SCULPT_WORK_DIR=/tmp/eva-w3-sculpt
EVA_SCULPT_REVIEW_EVERY=3
# Weave coordination hints, read by the task prompt—not SDK auth or gate enforcement.
# Optional stable, nonsecret URL/ID for a reusable workflow; leave blank for direct Weave model discovery.
# Neither route requires building a graph for every design task; this hint grants no spending approval.
EVA_WEAVE_TOOL_REF=
# Each pass uses <root>/<pass-id>/REVIEW.md plus provenance.json, references/images/,
# references/videos/, references/contact-sheet.png and implementation/before/ and after/.
# Link immutable fixed-location capture outputs from REVIEW.md instead of duplicating them.
# Existence of this path does not mean a packet has been generated or inspected.
EVA_WEAVE_PACKET_ROOT=week3/docs/design/revisions
# Runtime voice only: this does not set or approve a Weave credit budget.
EVA_W3_MAX_TURNS=0
BASH_DEFAULT_TIMEOUT_MS=300000
BASH_MAX_TIMEOUT_MS=600000

# Do not add OPENAI_API_KEY, ELEVENLABS_API_KEY, ELEVENLABS_VOICE_ID,
# ANTHROPIC_API_KEY, Figma/Weave tokens, Gateway URLs/tokens, expiring asset URLs,
# or credentials from the local archive. Do not invent a WEAVE_API_KEY or second MCP endpoint.
# The hosted Claude Code session supplies its own development-model authentication,
# NOT Figma/Weave authentication. Use an authorized official Figma connection or
# receive the current pass's inspected packet from the connected main session.
# Available credits, these variables and three-pass cadence do not authorize runs:
# obtain a finite allowance plus the tool's explicit per-run/default-input cost confirmation.
