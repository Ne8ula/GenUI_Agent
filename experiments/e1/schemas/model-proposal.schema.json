{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eva.local/schemas/e1/model-proposal.schema.json",
  "title": "E1 bounded model score proposal",
  "description": "Untrusted proposal only. Trusted evidence, status, authority, locks, budgets, seed, tokens, and timestamps belong to the host envelope and are intentionally absent.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "responseId",
    "baseRevision",
    "evidenceRefs",
    "intent",
    "entities",
    "phaseRecipe"
  ],
  "properties": {
    "schemaVersion": { "const": "e1.response-score-proposal/1" },
    "responseId": { "const": "response:e1-weather" },
    "baseRevision": { "type": "integer", "minimum": 0, "maximum": 1000000 },
    "evidenceRefs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/evidenceRef" }
    },
    "intent": {
      "enum": ["orient", "invite-comparison", "reconsider", "settle"]
    },
    "entities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": { "$ref": "#/$defs/entity" }
    },
    "phaseRecipe": { "$ref": "#/$defs/phaseRecipe" }
  },
  "$defs": {
    "timeId": { "enum": ["09:00", "12:00", "15:00"] },
    "evidenceRef": {
      "type": "string",
      "pattern": "^W-NYC-01:r1:(09:00|12:00|15:00):(temperature|cloudCover|precipitationProbability|wind)$",
      "maxLength": 64
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetId", "x", "y"],
      "properties": {
        "targetId": { "$ref": "#/$defs/timeId" },
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "primitive", "dataRefs", "unit", "anchor"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(field:primary|occlusion:primary|attention:primary|comparison:pair|fact:(09:00|12:00|15:00))$",
          "maxLength": 32
        },
        "primitive": {
          "enum": ["fact-anchor", "dither-field", "occlusion-layer", "attention-link", "comparison-pair"]
        },
        "dataRefs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/evidenceRef" }
        },
        "unit": { "enum": ["°C", "%", "km/h"] },
        "anchor": { "$ref": "#/$defs/anchor" },
        "count": { "type": "integer", "minimum": 1, "maximum": 8000 }
      }
    },
    "phaseRecipe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "durationMs", "elementBudget"],
      "properties": {
        "id": { "enum": ["part-and-relate", "withdraw-and-reanchor"] },
        "durationMs": { "type": "integer", "minimum": 0, "maximum": 5000 },
        "elementBudget": { "type": "integer", "minimum": 1, "maximum": 8000 }
      }
    }
  }
}
